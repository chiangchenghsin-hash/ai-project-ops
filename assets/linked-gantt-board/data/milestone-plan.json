{
  "schema": "ai-project-ops.milestone-plan/1.0",
  "charter": {
    "purpose": "Deliver the ai-project-ops English GitHub release command panel: an hour-axis linked gantt over a SQLite single source of truth, with a milestone main line, per-milestone sub-lines and FS/SS/FF/SF relations, so a human can steer an AI-led clean-room rewrite from one browser page.",
    "technical_resources": "Node 22.5 or newer with node:sqlite and no npm dependencies; vanilla TypeScript in assets/linked-gantt-board/src compiled by tsc to classic scripts in dist; scripts/ gate drivers verify.js, discipline-gate.js and prd-to-action.js; docs/evidence JSON as the read-only fact layer; PANEL_PORT 4174 default.",
    "evaluation": "PDCA iteration is the evaluation method: each round appends one Plan/Do/Check/Act entry to docs/TASK-LOG.md with pasted command output as Check evidence; acceptance is a re-run of the deterministic gates (scripts/prd-to-action.js, scripts/verify.js, scripts/selftest-discipline.js), never a numeric rating.",
    "side_purpose": "Milestone main line drives the gantt; sub-lines and relations keep the plan honest."
  },
