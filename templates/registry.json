      ],
      "benchmark": ".research/clickup-asana-motion.md#A3 + synthesis B1"
    },
    {
      "id": "owner-scope",
      "master": "templates/owner-scope.template.md",
      "instance": "docs/OWNER-SCOPE.md",
      "version": "1.1.0",
      "publish_role": "owner",
      "default_properties": [
        "owner_type",
        "may act alone",
        "needs ACK",
        "never automatic"
      ],
      "benchmark": "docs/competitive-synthesis.md claim 4 + B6"
    },
    {
